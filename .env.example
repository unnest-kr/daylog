# Optional. The app starts without an MCP server; chat needs a connected Flow.
# This URL must be reachable from inside the Daylog container.
# Also accepts /api/v1/run/FLOW_UUID for the Unnestflow Runtime Flow execution API.
MCP_URL=
MCP_TOOL=daily_report_assistant
UNNESTFLOW_API_KEY=
# Optional trusted certificate/CA PEM for a local HTTPS Flow execution API.
UNNESTFLOW_CA_CERT_FILE=
# Optional link shown in the browser. Use an address reachable by the user.
FLOW_URL=
# Optional local weekly-report demo: separate published Unnestflow Flow with
# the page-scoped Notion connector. Requires a shared persistent job directory.
NOTION_WEEKLY_FLOW_URL=
DAYLOG_PORT=3090
